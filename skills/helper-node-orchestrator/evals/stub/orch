#!/usr/bin/env bash
# Eval stub of orch: canned output per scenario, every call logged. Never touches a host, ssh or Docker.
# Scenario = one word in SCENARIO next to this file. Helper names: ORCH_STUB_NODES (default "h11 h12 h13").
# calls.log and state live next to this file (ORCH_STUB_LOG / ORCH_STUB_STATE override); delete both per scenario.
# state: line 1 the setup step, line 2 1 once the failing test was fixed, line 3 the journal task and counters,
# then one line per journal record. The output formats are the real CLI's (references/commands.md);
# answer JSON on stdin is checked like the real CLI does when a Python 3 is on PATH.
here=$(cd "$(dirname "$0")" && pwd)
sc=$(tr -d ' \r\n' < "$here/SCENARIO" 2>/dev/null)
log=${ORCH_STUB_LOG:-$here/calls.log}
stf=${ORCH_STUB_STATE:-$here/state}
read -r n1 n2 n3 _ <<< "${ORCH_STUB_NODES:-h11 h12 h13}"
n1=${n1:-h11}; n2=${n2:-h12}; n3=${n3:-h13}
s1="deploy@192.0.2.11"; s2="app-host"; s3="build@192.0.2.13:2222"   # what the user typed after ssh
root=$(pwd)
echo "$(date +%s) $*" >> "$log"
verb=${1:-}; shift || true
cur=""; fixed=0; jtask=-; jseq=0; useq=0; recs=""
if [ -f "$stf" ]; then { IFS= read -r cur; IFS= read -r fixed; read -r jtask jseq useq; } < "$stf"; recs=$(tail -n +4 "$stf"); fi
fixed=${fixed:-0}; jtask=${jtask:--}; jseq=${jseq:-0}; useq=${useq:-0}
if [ -z "$cur" ]; then   # where each scenario's setup starts
  case "$sc" in fresh) cur=count ;; missing) cur=setup1 ;; unapproved) cur=approve ;; drift) cur=drift ;;
                problem) cur=fix ;; *) cur=ready ;; esac
fi
L1="$n1 ($s1)"; L2="$n2 ($s2)"; L3="$n3 ($s3)"; P20="h20 (deploy@192.0.2.20:2222)"
SSHO="ssh -o BatchMode=yes -o StrictHostKeyChecking=yes -o ConnectTimeout=8 -o LogLevel=ERROR -o ServerAliveInterval=15 -o ServerAliveCountMax=3"
SUM="[\"helpers: $L1 everything incl. image builds; $L2 lint + tests, no image builds (also production); $L3 everything incl. image builds\", \"production: $P20, $L2\", \"deploy: ./scripts/deploy.sh | health https://shop.example/health | rollback -\", \"alerts: none\", \"jobs: api-lint (lint), api-unit (unit), web-lint (lint), web-unit (unit), api-image (image)\"]"
SHORT="helpers $L1 all, $L2 tests, $L3 all | prod $P20, $n2"
SHORT0="helpers $L1 all, $L2 tests, $L3 all | prod none"   # the fresh flow: "ok" saved production none, deploy later
OK="setup ok: $SHORT | 5 jobs | approved 2026-10-30"
OK0="setup ok: $SHORT0 | 5 jobs | approved 2026-10-30"
HEAD="Defaults are in [brackets]; reply ok to accept them all, or change any line.\nHelpers (role: helper only | helper + production; jobs: everything | lint + tests, no image builds | read-only commands only | nothing):"
H1="  $L1: 8 cpu, 15 GB, no other containers [helper only; everything]"
H2="  $L2: 16 cpu, 62 GB, 12 other containers [helper only; lint + tests, no image builds]"
H3="  $L3: 4 cpu, 8 GB, no other containers [helper only; everything]"
REST="Production servers (what you type after ssh, comma separated), or none / later [none]\nDeploy command - runs on THIS machine and must reach production itself, e.g. ./deploy.sh [later]\nHealth URL(s) checked after a deploy [-]\nRollback command (optional) [-]\nAlert command when a helper's own apps degrade (optional; gets the message on stdin) [none]"
WATCH="Extra app URLs to watch on shared helpers (optional) [-]"
JOBS="  api-lint  lint  dotnet 8  api/  2 GB  dotnet format --verify-no-changes\n  api-unit  unit  dotnet 8  api/  3 GB  dotnet test --no-restore\n  web-lint  lint  node 22  web/  2 GB  npm run lint\n  web-unit  unit  node 22  web/  2 GB  npm test\n  api-image  image  Dockerfile  api/  4 GB  docker build -f api/Dockerfile"
DETECT="  api-lint   lint   dotnet 8    api/  2 GB  dotnet format --verify-no-changes\n  api-unit   unit   dotnet 8    api/  3 GB  dotnet test --no-restore\n  web-lint   lint   node 22     web/  2 GB  npm run lint\n  web-unit   unit   node 22     web/  2 GB  npm test\n  api-image  image  Dockerfile  api/  4 GB  docker build -f api/Dockerfile"
F1="FAIL CartTests.Add_item_twice"; F2="FAIL CartTests.Remove_last_item"; F3="FAIL PriceTests.Rounds_half_up"
SHA="4f1c2e9a0b7d3c5e8f6a1b2c3d4e5f60718293a4"
NA="pick none: $n1: docker down: Cannot connect to the Docker daemon; $n2: job class JOB not in opt-in list; $n3: MemAvailable 1.9G - job 3.0G = -1.1G vs reserve 2.0G"
FIX_CMD="ask the user for the deploy command (relay the ask; orch init --ask deploy prints it again), save it with orch init --apply under the key deploy, run orch init --approve once the user says yes (a new deploy command needs approval), then run orch deploy --check again"

# the deploy question for a deploy answered "later": its example is exactly what the [brackets] say
DEPLOY_LATER='{"kind": "text", "header": "Deploy", "question": "A deploy needs the deploy command (defaults in [brackets]; reply with the command, or later):\nDeploy command - runs on THIS machine and must reach production itself, e.g. ./deploy.sh [later]\nHealth URL(s) checked after a deploy [-]\nRollback command (optional) [-]", "options": [], "multi": false, "answer_key": "deploy", "example": {"deploy": "later"}}'

pyok() { # the first Python 3 that runs (the Windows store alias does not)
  for p in python3 python py; do command -v "$p" >/dev/null 2>&1 && "$p" -c 'import sys' >/dev/null 2>&1 && { echo "$p"; return; }; done
}
PY=$(pyok)
isjson() { [ -z "$PY" ] && return 0; printf '%s' "$1" | "$PY" -c 'import json,sys; d=json.loads(sys.stdin.read()); sys.exit(0 if isinstance(d, dict) else 1)' 2>/dev/null; }
field() { printf '%s' "$1" | sed -n "s/.*\"$2\"[[:space:]]*:[[:space:]]*\"\([^\"]*\)\".*/\1/p" | head -1; }

save() { { echo "$cur"; echo "$fixed"; echo "$jtask $jseq $useq"; [ -n "$recs" ] && printf '%s\n' "$recs"; } > "$stf"; }
jnext() { if [ "$jtask" = - ]; then useq=$((useq + 1)); jseq_out=$useq; else jseq=$((jseq + 1)); jseq_out=$jseq; fi; save; }
jrec() { jnext; recs="${recs:+$recs
}$jseq_out $1 $2 $3"; save; }   # seq type by what

out() { # state step next summary problems ask; APPLIED and ERR (exit 2) come from the caller
  printf '{"state": "%s", "step": "%s", "summary": %s, "problems": %s, "ask": %s, "next": "%s", "applied": %s, "warnings": []%s}\n' \
    "$1" "$2" "$4" "$5" "$6" "$3" "${APPLIED:-[]}" "${ERR:+, \"error\": \"$ERR\"}"
}
ask() { # kind header question options multi answer_key example [extra json members]
  printf '{"kind": "%s", "header": "%s", "question": "%s", "options": %s, "multi": %s, "answer_key": %s, "example": %s%s}' \
    "$1" "$2" "$3" "$4" "$5" "$6" "$7" "${8:-}"
}
probe() {
  echo "$L1 ok: linux x86_64, 8 cpu, 15 GB, docker 27.3.1, no other containers"
  echo "$L2 ok: linux x86_64, 16 cpu, 62 GB, docker 26.1.4, 12 other containers"
  echo "$L3 ok: linux x86_64, 4 cpu, 8 GB, docker 27.3.1, no other containers"
}
status() {
  case "$cur" in
    ready|ready2) out ready none ready "[\"$OK\"]" "[]" null ;;
    ready0) out ready none ready "[\"$OK0\"]" "[]" null ;;
    count) out new count ask "[\"no orch setup yet for $root\"]" "[]" "$(ask choice Helpers \
             "How many helper servers will orch use?" '["1", "2", "3", "4+"]' false '"helper_count"' '{"helper_count": 2}')" ;;
    helpers) out incomplete helpers ask '["helpers: none yet", "production: not answered yet", "deploy: not answered yet", "alerts: not answered yet", "jobs: not chosen yet"]' "[]" "$(ask choice "Helper ssh" \
             "For each of the 3 helpers, what do you type after ssh? (alias, or user@IP[:port]; comma separated)" \
             '["app-host (192.0.2.12:22)", "spare (198.51.100.30:22)"]' true '"helpers"' '{"helpers": ["deploy@192.0.2.11", "deploy@192.0.2.12", "deploy@192.0.2.13"]}')" ;;
    setup) out incomplete setup ask "[\"helpers: $L1 jobs not chosen yet; $L2 jobs not chosen yet; $L3 jobs not chosen yet\", \"production: not answered yet\", \"deploy: not answered yet\", \"alerts: not answered yet\", \"jobs: not chosen yet\"]" "[]" "$(ask text Setup \
             "$HEAD\n$H1\n$H2\n$H3\n$REST\n$WATCH" "[]" false '"setup"' \
             "{\"hosts\": {\"$n1\": {\"roles\": [\"helper\"], \"jobs\": \"all\"}, \"$n2\": {\"roles\": [\"helper\", \"prod\"], \"jobs\": \"tests\"}, \"$n3\": {\"roles\": [\"helper\"], \"jobs\": \"all\"}}, \"production\": \"none\", \"deploy\": \"later\", \"alerts\": \"none\"}")" ;;
    setup1) out incomplete setup ask "[\"helpers: $L1 everything incl. image builds; $L2 lint + tests, no image builds (also production); $L3 jobs not chosen yet\", \"production: $P20, $L2\", \"deploy: ./scripts/deploy.sh | health https://shop.example/health | rollback -\", \"alerts: none\", \"jobs: api-lint (lint), api-unit (unit), web-lint (lint), web-unit (unit), api-image (image)\"]" "[]" "$(ask text Setup \
             "$HEAD\n$H3\n$WATCH" "[]" false '"setup"' "{\"hosts\": {\"$n3\": {\"roles\": [\"helper\"], \"jobs\": \"all\"}}}")" ;;
    jobs) out incomplete jobs ask "[\"helpers: $L1 everything incl. image builds; $L2 lint + tests, no image builds (also production); $L3 everything incl. image builds\", \"production: $L2\", \"deploy: later\", \"alerts: none\", \"jobs: not chosen yet\"]" "[]" "$(ask choice Jobs \
             "Jobs found in this project:\n$JOBS\nUse these jobs? (yes / change: tell me what to change)" \
             '["yes", "change"]' false '"jobs"' '{"jobs": "detected"}')" ;;
    approve0) out unapproved approve approve "[\"helpers: $L1 everything incl. image builds; $L2 lint + tests, no image builds (also production); $L3 everything incl. image builds\", \"production: $L2\", \"deploy: later\", \"alerts: none\", \"jobs: api-lint (lint), api-unit (unit), web-lint (lint), web-unit (unit), api-image (image)\"]" "[]" "$(ask choice Approve \
             "Setup: $SHORT0 | deploy later | alerts none | 5 jobs\nSave and use this setup?" '["yes", "no"]' false null null)" ;;
    approve|approve1) out unapproved approve approve "$SUM" "[]" "$(ask choice Approve \
             "Setup: $SHORT | deploy ./scripts/deploy.sh | alerts none | 5 jobs\nSave and use this setup?" '["yes", "no"]' false null null)" ;;
    approve-later) out unapproved approve approve "$SUM" "[]" "$(ask choice Approve \
             "Setup: $SHORT | deploy ./scripts/deploy.sh | alerts none | 5 jobs\nChanges that loosen protection since the last approval:\n  deploy command added: ./scripts/deploy.sh\nSave and use this setup?" '["yes", "no"]' false null null)" ;;
    drift) out drift jobs ask "$SUM" "[]" "$(ask choice Jobs \
             "Changed since approval:\n  api-unit: api/Api.csproj changed since approval; detected dotnet 9 (api/Api.csproj), saved dotnet 8 (api/Api.csproj)\nTake the new detection for these jobs? (yes / keep: keep the saved jobs and stop asking)" \
             '["yes", "keep"]' false '"jobs"' '{"jobs": {"api-unit": {"stage": "unit", "kind": "container", "image": "mcr.microsoft.com/dotnet/sdk:9.0", "dir": "api", "prep": "dotnet restore", "cmd": "dotnet test --no-restore", "memory": "3g", "timeout": 1200, "detected": "dotnet 9 (api/Api.csproj)", "files": ["api/Api.csproj"], "manifest": "sha256:9c1d"}}}' \
             ', "examples": {"yes": {"jobs": {"api-unit": {"stage": "unit", "kind": "container", "image": "mcr.microsoft.com/dotnet/sdk:9.0", "dir": "api", "prep": "dotnet restore", "cmd": "dotnet test --no-restore", "memory": "3g", "timeout": 1200, "detected": "dotnet 9 (api/Api.csproj)", "files": ["api/Api.csproj"], "manifest": "sha256:9c1d"}}}, "keep": {"jobs": {"api-unit": {"manifest": "sha256:9c1d"}}}}')" ;;
    drift2) out drift approve approve "$SUM" "[]" "$(ask choice Changed \
             "Changed since approval:\n  $L1: now runs 3 other containers (app1-cache, app1-db, app1-web); it had none when approved [keep: helper only; everything]\nKeep this setup? (yes / change: tell me what to change)" \
             '["yes", "change"]' false null null)" ;;
    fix) out drift fix fix "$SUM" \
             "[{\"host\": \"$L2\", \"what\": \"ssh: deploy@192.0.2.12: Permission denied (publickey).\", \"tried\": \"$SSHO $s2 true\", \"fix\": \"ssh-copy-id $s2\"}]" \
             "$(ask choice Fix "$L2: ssh: deploy@192.0.2.12: Permission denied (publickey). -> ssh-copy-id $s2\nRun the fix shown, then choose retry; or remove the host." \
             "[\"retry\", \"remove $n2\"]" false '"remove_hosts"' "{\"remove_hosts\": [\"$n2\"]}")" ;;
  esac
}
refuse() { # verbs that use the setup refuse anything but a ready one
  local e="the orch setup of $root is not approved yet: run orch init to review and approve it"
  echo "orch: $e" >&2; echo "{\"result\": \"usage\", \"exit\": 2, \"error\": \"$e\", \"next\": \"run orch init\"}"
}
ready() { case "$cur" in ready|ready0|ready2) return 0 ;; *) return 1 ;; esac; }
res() { # result exit job id node wall failures reason
  echo "{\"result\": \"$1\", \"exit\": $2, \"job\": \"$3\", \"jobid\": \"$4\", \"node\": $( [ -n "$5" ] && echo "\"$5\"" || echo null ), \"wall_s\": $6, \"wait_s\": 0.4, \"overhead_s\": 9.1, \"failures\": [$7], \"reason\": $( [ -n "$8" ] && echo "\"$8\"" || echo null ), \"results\": \"<dir>\", \"log\": \"<path>\", \"sha\": \"$SHA\", \"wt\": false}"
}
node_of() { if [ "$sc" = parallel ] && [ "${1#web-}" != "$1" ]; then echo "$n2"; else echo "$n1"; fi; }
gates() { # deploy --check output: a line per failing gate, the summary line, and the JSON gates array in G
  # $1 = blocked | later | ready | check
  local sh7 pd pdj po=ok hp=ok hd hf="" jo=ok jd jf="" pf="" nf=0
  sh7=$(printf %.7s "$SHA")
  pd="$P20, $L2; deploy command ./scripts/deploy.sh"; pdj=$pd
  hd="$sh7 is on origin/main (last fetched state; orch does not fetch)"
  jd="api-lint, api-unit, web-lint, web-unit passed for $sh7 (runs without --wt)"
  if [ "$1" = later ]; then
    po=fail; pd="$P20, $L2; the deploy command is \"later\": not decided yet"; pdj="$P20, $L2; the deploy command is \\\"later\\\": not decided yet"
    pf="ask the user for the deploy command (relay the ask; orch init --ask deploy prints it again), save it with orch init --apply under the key deploy, run orch init --approve once the user says yes (a new deploy command needs approval), then run orch deploy --check again"
  fi
  if [ "$1" = blocked ]; then hp=fail; hd="no upstream branch: push first (git push -u origin main)"; hf="git push -u origin main"; fi
  if [ "$1" = check ]; then
    jo=fail; jf="orch ci --stages lint,unit"; jd=""
    for j in api-lint api-unit web-lint web-unit; do jd="$jd${jd:+; }$j: no run for $sh7 (the last run was pass for 9b8a7c6)"; done
  fi
  [ $po = fail ] && { echo "FAIL production answered: $pd"; nf=$((nf + 1)); }
  [ $hp = fail ] && { echo "FAIL HEAD pushed: $hd"; nf=$((nf + 1)); }
  [ $jo = fail ] && { echo "FAIL required jobs: $jd"; nf=$((nf + 1)); }
  if [ $nf = 0 ]; then echo "ready: 7 ok (7 gates)"; else echo "NOT ready: $nf failed, $((7 - nf)) ok (7 gates)"; fi
  tf() { [ "$1" = ok ] && echo true || echo false; }
  G="[{\"name\": \"setup approved\", \"ok\": true, \"status\": \"ok\", \"detail\": \"approved 2026-10-30 09:20\", \"fix\": \"\"}, {\"name\": \"production answered\", \"ok\": $(tf $po), \"status\": \"$po\", \"detail\": \"$pdj\", \"fix\": \"$pf\"}, {\"name\": \"tree clean\", \"ok\": true, \"status\": \"ok\", \"detail\": \"nothing uncommitted or untracked\", \"fix\": \"\"}, {\"name\": \"HEAD pushed\", \"ok\": $(tf $hp), \"status\": \"$hp\", \"detail\": \"$hd\", \"fix\": \"$hf\"}, {\"name\": \"required jobs\", \"ok\": $(tf $jo), \"status\": \"$jo\", \"detail\": \"$jd\", \"fix\": \"$jf\"}, {\"name\": \"scripts unchanged\", \"ok\": true, \"status\": \"ok\", \"detail\": \"scripts/deploy.sh matches the approved content\", \"fix\": \"\"}, {\"name\": \"production reachable\", \"ok\": true, \"status\": \"ok\", \"detail\": \"$P20, $L2 answered ssh\", \"fix\": \"\"}]"
}

dispatch() {
case "$verb" in
  init)
    case "${1:-}" in
      --apply) body=$(cat); echo "$(date +%s) stdin: $(printf '%s' "$body" | tr -d '\r\n')" >> "$log"
               if ! isjson "$body"; then
                 ERR="the answer is not one valid JSON object; orch init --apply reads the answer JSON on stdin; send it with a quoted heredoc"
                 echo "orch init: $ERR" >&2; status; return 2
               fi
               case "$cur" in count) cur=helpers; APPLIED='["helper_count: 3 helpers"]' ;;
                              helpers) cur=setup; APPLIED="[\"helpers: $L1 added; $L2 added; $L3 added\"]"; probe ;;
                              setup) cur=jobs ;; jobs) cur=approve0 ;; setup1) cur=approve1 ;;
                              drift) cur=drift2; APPLIED='["jobs: api-unit changed (image, detected, files, manifest)", "approval: kept (no change loosens protection)"]' ;;
                              ready) [ "$sc" = gate-later ] && cur=approve-later ;; esac
               save; status ;;
      --approve) case "$cur" in approve|approve0|approve1|approve-later|drift2) ;; *)
                   ERR="the setup question is not answered yet: run orch init and answer it, then approve"
                   echo "orch init: $ERR" >&2; status; return 2 ;; esac
                 echo "pinned mcr.microsoft.com/dotnet/sdk:8.0 -> sha256:1f2e3d4c5b6a... (via this machine)"
                 echo "pinned node:22-bookworm -> sha256:6a5b4c3d2e1f... (via helper $n1)"
                 APPLIED='["approved: 2 images pinned, 1 deploy script hashed"]'
                 case "$cur" in approve0) cur=ready0 ;; approve-later) cur=ready2 ;; *) cur=ready ;; esac
                 save; status ;;
      --detect) echo -e "jobs detected:\n$DETECT"; ready && echo "compared with the saved jobs: no difference"; status ;;
      --show) echo "project $root (setup in $root/.git/orch)"; probe; status ;;
      --ask) case "${2:-}" in
               deploy) if [ "$sc" = gate-later ] && [ "$cur" != ready2 ] && [ "$cur" != approve-later ]; then
                         out ready setup ask "$SUM" "[]" "$DEPLOY_LATER"
                       else
                         out ready setup ask "$SUM" "[]" "$(ask text Deploy "A deploy needs the deploy command (defaults in [brackets]; reply with the command, or later):\nDeploy command - runs on THIS machine and must reach production itself, e.g. ./deploy.sh [./scripts/deploy.sh]\nHealth URL(s) checked after a deploy [https://shop.example/health]\nRollback command (optional) [-]" "[]" false '"deploy"' '{"deploy": {"command": "./scripts/deploy.sh", "health": ["https://shop.example/health"], "rollback": null}}')"
                       fi ;;
               production) out ready setup ask "$SUM" "[]" "$(ask text Production "A deploy needs the production servers this project deploys to:\nProduction servers (what you type after ssh, comma separated), or none / later [deploy@192.0.2.20:2222]" "[]" false '"production"' '{"production": ["deploy@192.0.2.20:2222"]}')" ;;
               *) echo "orch init: --ask takes deploy or production" >&2; return 2 ;;
             esac ;;
      --offline|"") status ;;
      *) echo "usage: orch init [--offline] [--apply] [--detect] [--approve] [--show] [--ask {deploy,production}] [--project DIR]" >&2; return 2 ;;
    esac ;;
  journal)
    act=${1:-}
    case "$act" in start|add|end) body=$(cat); echo "$(date +%s) stdin: $(printf '%s' "$body" | tr -d '\r\n')" >> "$log"
                     if ! isjson "$body"; then
                       echo "orch journal: journal $act needs one JSON object on stdin, sent with a quoted heredoc" >&2
                       echo "{\"ok\": false, \"exit\": 2, \"error\": \"journal $act needs one JSON object on stdin, sent with a quoted heredoc\"}"; return 2
                     fi ;; esac
    case "$act" in
      start) [ -n "$(field "$body" summary)" ] || { echo '{"ok": false, "exit": 2, "error": "journal start needs \"summary\""}'; return 2; }
             jtask="t20261030-120000-ab12"; jseq=0; jrec task-start agent "$(field "$body" summary)"
             echo "journal: task $jtask started"
             echo "{\"ok\": true, \"task\": \"$jtask\", \"seq\": 1, \"type\": \"task-start\", \"closed\": [], \"open\": [], \"next\": \"orch logs its commands itself (steps, failures, later passes); add your decisions, problems orch cannot see and their fixes (no secrets), then orch journal end\"}" ;;
      add) t=$(field "$body" type)
           case "$t" in plan|decision|step|difficulty|resolution|note) ;; *)
             echo "{\"ok\": false, \"exit\": 2, \"error\": \"journal add needs \\\"type\\\", one of plan, decision, step, difficulty, resolution, note\"}"; return 2 ;; esac
           jrec "$t" agent "$(field "$body" what)$(field "$body" how)$(field "$body" text)"
           tk=$jtask; [ "$tk" = - ] && tk=untracked
           echo "journal: $tk #$jseq_out $t recorded"
           if [ "$t" = difficulty ]; then
             echo "{\"ok\": true, \"task\": \"$tk\", \"seq\": $jseq_out, \"type\": \"difficulty\", \"next\": \"when it is fixed:\\norch journal add <<'EOF'\\n{\\\"type\\\": \\\"resolution\\\", \\\"for\\\": $jseq_out, \\\"how\\\": \\\"...\\\"}\\nEOF\"}"
           else echo "{\"ok\": true, \"task\": \"$tk\", \"seq\": $jseq_out, \"type\": \"$t\"}"; fi ;;
      end) [ "$jtask" = - ] && { echo '{"ok": false, "exit": 2, "error": "no current journal task to end; start one with orch journal start"}'; return 2; }
           o=$(field "$body" outcome); case "$o" in done|partial|failed|blocked|abandoned) ;; *)
             echo '{"ok": false, "exit": 2, "error": "journal end needs \"outcome\": done, partial, failed, blocked or abandoned"}'; return 2 ;; esac
           jrec task-end agent "$o"
           echo "journal: task $jtask ended $o in 5m 00s; summary in $root/.git/orch/journal/MEMORY.md"
           echo "{\"ok\": true, \"task\": \"$jtask\", \"seq\": $jseq_out, \"type\": \"task-end\", \"outcome\": \"$o\", \"duration_s\": 300.0, \"memory\": \"$root/.git/orch/journal/MEMORY.md\"}"
           jtask=-; jseq=0; save ;;
      show) [ -n "$recs" ] && printf '%s\n' "$recs" | sed 's/^\([0-9]*\) /2026-10-30 12:00:00 t20261030-120000-ab12 #\1 /' | tail -n 50 ;;
      stats) echo "journal stats: $([ -n "$recs" ] && printf '%s\n' "$recs" | wc -l | tr -d ' ' || echo 0) records" ;;
      path) echo "journal $root/.git/orch/journal/journal.jsonl"; echo "memory $root/.git/orch/journal/MEMORY.md" ;;
      *) echo "usage: orch journal {start,add,end,show,stats,path} [--task TASK] [--last LAST] [--days DAYS] [--json] [--project PROJECT]" >&2; return 2 ;;
    esac ;;
  nodes)
    ready || { refuse; return 2; }
    echo "config: project $root"
    if [ "$sc" = not-admitted ]; then echo "$n1 down docker down: Cannot connect to the Docker daemon -"; else echo "$n1 ok docker 9.8G/15.6G psi=0.1 load=0.40/8 -"; fi
    echo "$n2 ok docker 21.0G/62.0G psi=0.3 load=1.10/16 -"
    echo "$n3 ok docker $([ "$sc" = not-admitted ] && echo 1.9G || echo 5.2G)/7.8G psi=0.2 load=0.70/4 -" ;;
  plan)
    ready || { refuse; return 2; }
    echo "config: project $root"
    if [ "$sc" = not-admitted ]; then echo "${NA//JOB/${1:-job}}"; return 75; fi
    echo "$n1 admit 0.82 ok"; echo "$n2 admit 0.61 ok"; echo "$n3 admit 0.40 ok"; echo "pick $(node_of "${1:-job}")" ;;
  run)
    job=${1:-}; id="1030120000$(printf '%s' "$job" | cksum | cut -c1-4)"
    ready || { refuse; return 2; }
    if [ "$sc" = not-admitted ]; then r=${NA//JOB/$job}; echo "$r" >&2; res not-admitted 75 "$job" "$id" "" 0 "" "$r"; return 75; fi
    node=$(node_of "$job")
    echo "pick $node" >&2; echo "start $id on $node" >&2; echo "prep done" >&2; echo "tests start" >&2
    if [ "$sc" = unit-fail ] && [ "$job" = api-unit ] && [ "$fixed" = 0 ]; then
      echo "end exit=1" >&2; echo "cleanup ok" >&2
      res test-fail 1 "$job" "$id" "$node" 214 "\"$F1\", \"$F2\", \"$F3\"" "tests failed: $F1"; fixed=1; save; return 1
    fi
    echo "end exit=0" >&2; echo "cleanup ok" >&2; res pass 0 "$job" "$id" "$node" 187 "" "" ;;
  ci)
    ready || { refuse; return 2; }
    stages="lint,unit,build,image,e2e"; only=""; keep=0
    while [ $# -gt 0 ]; do case "$1" in --stages) stages=$2; shift 2 ;; --jobs) only=",$2,"; shift 2 ;;
                                      --keep-going) keep=1; shift ;; --wait|--ref) shift 2 ;; *) shift ;; esac; done
    sel() { for j in api-lint web-lint api-unit web-unit api-image; do
              case "$j" in *-lint) s=lint ;; *-unit) s=unit ;; *) s=image ;; esac
              if [ -n "$only" ]; then case "$only" in *",$j,"*) echo "$j $s" ;; esac
              else case ",$stages," in *",$s,"*) echo "$j $s" ;; esac; fi; done; }
    g1=$(sel | awk '$2!="image"{print $1}'); g2=$(sel | awk '$2=="image"{print $1}')
    l1=$(sel | awk '$2!="image"{print $2}' | sort -u | tr '\n' '+' | sed 's/+$//'); [ "$l1" = "unit+lint" ] && l1="lint+unit"
    worst=0; js=""; red=""
    for grp in 1 2; do
      [ $grp = 1 ] && names=$g1 || names=$g2
      [ -z "$names" ] && continue
      nx=done; [ $grp = 1 ] && [ -n "$g2" ] && nx=image
      for job in $names; do
        node=$(node_of "$job"); id="10301200$(printf '%s' "$job" | cksum | cut -c1-6)"; f=null; rs=null
        if [ -n "$red" ] && [ "$keep" = 0 ]; then
          echo "$job - skipped 0s | not run: $red is red (--keep-going runs it) | next: -"; e=null; r=skipped; node=""; w=null; rs="\"not run: $red is red (--keep-going runs it)\""; n="-"
        elif [ "$sc" = not-admitted ]; then
          r=${NA//JOB/$job}; echo "$job - not-admitted 0s | $r | next: stop"; e=75; rs="\"$r\""; r=not-admitted; node=""; w=null; n=stop
        elif [ "$sc" = unit-fail ] && [ "$job" = api-unit ] && [ "$fixed" = 0 ]; then
          echo "$job $node test-fail 214s | tests failed: $F1 | next: Development"
          echo "failed: $F1, $F2, $F3"; e=1; r=test-fail; w=214; f="[\"$F1\", \"$F2\", \"$F3\"]"; rs="\"tests failed: $F1\""; n=Development; fixed=1; save
        else
          echo "$job $node pass 187s | - | next: $nx"; e=0; r=pass; w=187; n=$nx
        fi
        [ "$e" = 75 ] && worst=75; [ "$e" = 1 ] && [ "$worst" = 0 ] && worst=1
        js="$js${js:+, }{\"job\": \"$job\", \"stage\": \"$(sel | awk -v j="$job" '$1==j{print $2}')\", \"result\": \"$r\", \"exit\": $e, \"node\": $( [ -n "$node" ] && echo "\"$node\"" || echo null ), \"wall_s\": $w, \"reason\": $rs, \"failures\": $f, \"jobid\": \"$id\", \"sha\": \"$SHA\", \"wt\": false, \"next\": \"$n\"}"
      done
      if [ "$worst" != 0 ] && [ -z "$red" ]; then red=$([ $grp = 1 ] && echo "$l1" || echo image); fi
    done
    result=pass; nxt=done; [ "$worst" = 1 ] && { result=test-fail; nxt=Development; }; [ "$worst" = 75 ] && { result=not-admitted; nxt=stop; }
    echo "{\"result\": \"$result\", \"exit\": $worst, \"jobs\": [$js], \"next\": \"$nxt\"}"; return "$worst" ;;
  deploy)
    if [ "${1:-}" != --check ]; then
      echo "orch: usage: orch does not deploy: run orch deploy --check, then the deploy command saved in the setup" >&2
      echo '{"result": "usage", "exit": 2, "error": "orch does not deploy: run orch deploy --check, then the deploy command saved in the setup", "next": "orch deploy --check"}'; return 2
    fi
    if [ "$sc" = gate-blocked ]; then
      gates blocked; echo "{\"ready\": false, \"gates\": $G, \"next\": \"git push -u origin main\", \"ref\": \"HEAD\", \"sha\": \"$SHA\"}"; return 7
    fi
    if [ "$sc" = gate-later ] && [ "$cur" != ready2 ]; then
      gates later; echo "{\"ready\": false, \"gates\": $G, \"next\": \"$FIX_CMD\", \"ref\": \"HEAD\", \"sha\": \"$SHA\", \"ask\": $DEPLOY_LATER}"; return 7
    fi
    if [ "$sc" = deploy-check ]; then
      gates check; echo "{\"ready\": false, \"gates\": $G, \"next\": \"orch ci --stages lint,unit\", \"ref\": \"HEAD\", \"sha\": \"$SHA\"}"; return 7
    fi
    gates ready; echo "{\"ready\": true, \"gates\": $G, \"next\": \"run the deploy command: ./scripts/deploy.sh, then orch live\", \"ref\": \"HEAD\", \"sha\": \"$SHA\"}" ;;
  live)
    echo "ok   https://shop.example/health 200 0.21s"
    echo '{"ok": true, "checks": [{"url": "https://shop.example/health", "status": 200, "ms": 214, "tries": 1, "error": null, "insecure": false}], "next": "check that the change is visible (read-only GET or SELECT), then hand over for UAT"}' ;;
  logs)
    id=${1:-}; shift
    if [ "${1:-}" = --all ]; then for i in $(seq 1 5000); do echo "log line $i"; done; return 0; fi
    f=$([ "$sc" = unit-fail ] && echo test-fail || echo pass)
    echo "$id job=api-unit node=$n1 result=$f exit=$([ "$f" = pass ] && echo 0 || echo 1) wall=214s lines=5000 log=<path>"
    if [ "$sc" = unit-fail ]; then echo "failures:"; printf '  %s\n' "$F1" "$F2" "$F3"; fi
    echo "--- last 80 of 5000 lines (--all for the full log)"; for i in $(seq 4921 5000); do echo "log line $i"; done ;;
  status) echo "session 1a2b3c owner dev home ~/.helper-orch"; echo "live jobs: none"; echo "recent jobs:"
          for n in "$n1" "$n2" "$n3"; do echo "$n: agent objects: none"; done ;;
  inventory) ready || { refuse; return 2; }
             echo "${1:-$n1} images 41.2G containers 3.1G volumes 18.0G build-cache 0.9G"; echo "agent: none"; echo "fingerprint: unchanged" ;;
  gc) [ "${1:-}" = --session-end ] || { echo "usage: orch gc --session-end [--node NAME]"; return 2; }
      ready || { refuse; return 2; }
      for n in "$n1" "$n2" "$n3"; do echo "$n: removed 0: -"; echo "$n: agent objects left: 0"; done ;;
  *) echo "orch stub: verb not covered by the evals: $verb" >&2; return 2 ;;
esac
}

dispatch "$@"; rc=$?
if [ "$verb" != journal ] && [ -n "$verb" ]; then   # orch journals its own calls: a step, plus a difficulty on failure
  cmd="orch $verb $*"
  jrec step orch "$cmd"
  if [ "$rc" != 0 ] && [ "$verb" != ci ]; then
    jrec difficulty orch "$cmd exited $rc"; echo "journal: difficulty #$jseq_out recorded (orch)" >&2
  elif [ "$rc" = 0 ]; then   # a later pass of the same command resolves each of its open difficulties
    for d in $(printf '%s\n' "$recs" | awk -v c="$cmd" 'index($0, " difficulty orch " c " exited ") {print $1}'); do
      printf '%s\n' "$recs" | grep -q " resolution orch for #$d:" || jrec resolution orch "for #$d: $cmd passed later"
    done
  fi
fi
exit "$rc"
