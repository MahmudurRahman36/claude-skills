#!/usr/bin/env bash
# orch: helper-node orchestrator entry point. Finds a Python 3.10+ and runs orch.py next to this file.
# Order: $ORCH_PYTHON, python3, python, py (the Windows launcher). Set ORCH_PYTHON=/path/to/python to pin one.
set -u
here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && (pwd -W 2>/dev/null || pwd))
for py in "${ORCH_PYTHON:-}" python3 python py; do
  [ -n "$py" ] || continue
  command -v "$py" >/dev/null 2>&1 || [ -x "$py" ] || continue
  "$py" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 10) else 1)' >/dev/null 2>&1 || continue
  exec "$py" -u "$here/orch.py" "$@"
done
echo "orch: no Python 3.10+ found on PATH (tried \$ORCH_PYTHON, python3, python, py): install Python 3.10+ or set ORCH_PYTHON=/path/to/python" >&2
exit 2
